# ===== App =====
APP_ENV=development
APP_NAME=lx-platform
DEBUG=true
SECRET_KEY=CHANGE_ME_STRONG_SECRET
HOST=0.0.0.0
PORT=8000

# ===== Database =====
# 留空 MYSQL_HOST 时后端将使用本地 SQLite（便于无 Docker 快速跑通）
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=lx_platform
MYSQL_USER=lx_app
MYSQL_PASSWORD=CHANGE_ME

# ===== Redis =====
# 留空 REDIS_HOST 时后端使用内存降级实现（锁/缓存/限流仍可用）
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== RabbitMQ / Celery =====
# CELERY_ENABLED=false 时，撮合与 24h 扫描将在进程内同步/后台调度执行
CELERY_ENABLED=false
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=lx
RABBITMQ_PASSWORD=CHANGE_ME
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ===== JWT =====
# 生产环境请使用 openssl rand -hex 32 生成随机密钥
JWT_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_1234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=2592000

# ===== Upload =====
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_EXT=jpg,jpeg,png,pdf,webp
UPLOAD_DIR=uploads

# ===== 初始超级管理员 =====
ADMIN_INIT_USERNAME=superadmin
ADMIN_INIT_PASSWORD=Admin@123456

# ===== 平台配置 =====
DEFAULT_SERVICE_FEE_RATE=0.05
WITHDRAW_MIN_AMOUNT=100
WITHDRAW_DAILY_LIMIT=50000
